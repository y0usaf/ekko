(defpackage #:ekko/vt
  (:use #:cl)
  (:export #:make-terminal #:feed #:resize-terminal #:terminal-cols #:terminal-rows
           #:terminal-cw #:terminal-ch #:terminal-x #:terminal-y #:terminal-cells
           #:terminal-modes #:terminal-keyboards #:terminal-revision #:terminal-screen
           #:terminal-parser #:terminal-buffer #:terminal-visible #:terminal-title
           #:terminal-history #:history-count #:history-cells #:history-text #:clear-history
           #:terminal-materialized-rows #:terminal-erase-display-history
           #:parameters #:row-text #:character-width #:update-rendition #:colour-report
           #:row-revision #:packed-row-runs #:scroll-region))
(in-package #:ekko/vt)

(deftype cell () '(unsigned-byte 58))
(deftype cell-row () '(simple-array (unsigned-byte 64) (*)))
(defconstant +glyph-mask+ #xffffff)
(defconstant +wide+ #x1000000)
(defconstant +tail+ #x2000000)
(defconstant +style-shift+ 26)
(defconstant +cluster-base+ #x110000)
(declaim (inline row-cols row-revision row-wrap cell-glyph cell-style cell-wide-p cell-tail-p touch-row))
(defun row-cols (row) (declare (type cell-row row)) (- (length row) 2))
(defun row-revision (row) (declare (type cell-row row)) (aref row (1- (length row))))
(defun (setf row-revision) (value row) (declare (type cell-row row)) (setf (aref row (1- (length row))) value))
(defun row-wrap (row) (declare (type cell-row row)) (aref row (- (length row) 2)))
(defun (setf row-wrap) (value row) (declare (type cell-row row)) (setf (aref row (- (length row) 2)) value))
(defun cell-glyph (cell) (declare (type cell cell)) (logand cell +glyph-mask+))
(defun cell-style (cell) (declare (type cell cell)) (ash cell (- +style-shift+)))
(defun cell-wide-p (cell) (declare (type cell cell)) (logtest cell +wide+))
(defun cell-tail-p (cell) (declare (type cell cell)) (logtest cell +tail+))
(defun make-row (cols) (make-array (+ cols 2) :element-type '(unsigned-byte 64) :initial-element 0))
(defun blank-cells (cols rows)
  (let ((cells (make-array rows)))
    (dotimes (y rows cells) (setf (svref cells y) (make-row cols)))))
(defstruct (terminal (:constructor %make-terminal))
  (cols 80 :type fixnum) (rows 24 :type fixnum) (cw 8) (ch 16)
  (x 0 :type fixnum) (y 0 :type fixnum) (saved '(0 0))
  (cells #() :type simple-vector) main-cells history (screen :main)
  (top 0 :type fixnum) (bottom 23 :type fixnum) (visible t)
  (materialized-rows 1 :type fixnum) (main-materialized-rows 1 :type fixnum)
  (erase-display-history nil) (rendition '(0))
  (modes (make-hash-table)) (keyboards (list 0))
  (charsets (list nil nil)) (shift 0 :type fixnum) (cursor-saves (vector nil nil))
  (insert nil) (tabs :default) (last-char nil) (wrap t) (join-blocked nil)
  (parser :ground) (buffer (make-array 0 :element-type '(unsigned-byte 8) :adjustable t :fill-pointer 0))
  (utf-code 0 :type fixnum) (utf-left 0 :type fixnum) (utf-min 0 :type fixnum)
  (revision 0 :type fixnum) (title nil)
  (renditions (make-hash-table :test 'equal))
  (styles (make-array 128 :initial-element nil) :type simple-vector)
  (style-count 1 :type fixnum) (style-limit 65536 :type fixnum) (pen 0 :type fixnum)
  (clusters (make-array 128 :element-type '(unsigned-byte 64) :initial-element 0) :type cell-row)
  (cluster-lengths (make-array 128 :element-type '(unsigned-byte 32) :initial-element 0)
                   :type (simple-array (unsigned-byte 32) (*)))
  (cluster-table (make-hash-table :test 'eql)) (cluster-count 0 :type fixnum)
  (cluster-limit 16384 :type fixnum))
(defun make-terminal (&key (cols 80) (rows 24) (cw 8) (ch 16) (erase-display-history nil))
  (unless (and (typep cols '(integer 1 65535)) (typep rows '(integer 1 65535)))
    (error "Invalid terminal dimensions: ~S x ~S" cols rows))
  (let ((vt (%make-terminal :cols cols :rows rows :cw cw :ch ch :bottom (1- rows)
                            :erase-display-history erase-display-history :cells (blank-cells cols rows))))
    (setf (svref (terminal-styles vt) 0) '(0) (gethash '(0) (terminal-renditions vt)) 0)
    vt))
(defun touch-row (vt row)
  (declare (type terminal vt) (type cell-row row))
  (setf (row-revision row) (terminal-revision vt)))
(defun ensure-materialized-rows (vt count)
  (when (eq (terminal-screen vt) :main)
    (setf (terminal-materialized-rows vt) (min (terminal-rows vt) (max (terminal-materialized-rows vt) count)))))
(defun map-rows (vt function)
  (loop for row across (terminal-cells vt) do (funcall function row))
  (when (terminal-main-cells vt)
    (loop for row across (terminal-main-cells vt) do (funcall function row)))
  (dolist (row (history-above vt)) (funcall function row)))
(defun compact-interns (vt)
  (let* ((styles (terminal-styles vt)) (clusters (terminal-clusters vt))
         (style-map (make-array (terminal-style-count vt) :element-type '(unsigned-byte 32) :initial-element 0))
         (cluster-map (make-array (terminal-cluster-count vt) :element-type '(unsigned-byte 32) :initial-element 0))
         (live (make-array (terminal-cluster-count vt) :element-type 'bit :initial-element 0))
         (new-styles (make-array (length styles) :initial-element nil))
         (new-clusters (make-array (length clusters) :element-type '(unsigned-byte 64) :initial-element 0))
         (new-lengths (make-array (length clusters) :element-type '(unsigned-byte 32) :initial-element 0))
         (style-table (make-hash-table :test 'equal)) (cluster-table (make-hash-table :test 'eql))
         (ns 1) (nc 0))
    (setf (svref new-styles 0) '(0) (gethash '(0) style-table) 0)
    (labels ((style-id (id)
               (if (zerop id) 0
                   (or (let ((n (aref style-map id))) (and (plusp n) n))
                       (let ((n ns) (style (svref styles id)))
                         (incf ns) (setf (aref style-map id) n (svref new-styles n) style (gethash style style-table) n) n))))
             (mark-glyph (glyph)
               (loop while (>= glyph +cluster-base+) for id = (- glyph +cluster-base+)
                     while (zerop (sbit live id)) do
                       (setf (sbit live id) 1 glyph (logand (aref clusters id) +glyph-mask+))))
             (mapped-glyph (glyph)
               (if (< glyph +cluster-base+) glyph (+ +cluster-base+ (aref cluster-map (- glyph +cluster-base+))))))
      (map-rows vt (lambda (row)
                     (declare (type cell-row row))
                     (dotimes (x (row-cols row)) (mark-glyph (cell-glyph (aref row x))))))
      (dotimes (id (terminal-cluster-count vt))
        (when (= (sbit live id) 1)
          (let* ((node (aref clusters id)) (parent (mapped-glyph (logand node +glyph-mask+)))
                 (key (logior parent (logandc2 node +glyph-mask+))))
            (setf (aref cluster-map id) nc (aref new-clusters nc) key
                  (aref new-lengths nc) (aref (terminal-cluster-lengths vt) id)
                  (gethash key cluster-table) nc)
            (incf nc))))
      (map-rows vt (lambda (row)
                     (declare (type cell-row row))
                     (dotimes (x (row-cols row))
                       (let ((cell (aref row x)))
                         (setf (aref row x) (logior (mapped-glyph (cell-glyph cell))
                                                   (logand cell (logior +wide+ +tail+))
                                                   (ash (style-id (cell-style cell)) +style-shift+)))))))
      (multiple-value-bind (old found) (gethash (terminal-rendition vt) (terminal-renditions vt))
        (when found (style-id old))))
    (setf new-styles (subseq new-styles 0 (max 128 ns))
          new-clusters (subseq new-clusters 0 (max 128 nc))
          new-lengths (subseq new-lengths 0 (max 128 nc)))
    (setf (terminal-styles vt) new-styles (terminal-style-count vt) ns
          (terminal-renditions vt) style-table (terminal-clusters vt) new-clusters
          (terminal-cluster-lengths vt) new-lengths
          (terminal-cluster-count vt) nc (terminal-cluster-table vt) cluster-table
          (terminal-style-limit vt) (max 65536 (* 2 ns)) (terminal-cluster-limit vt) (max 16384 (* 2 nc)))
    (setf (terminal-pen vt) (ash (gethash (terminal-rendition vt) style-table 0) +style-shift+))))
(defun canonical-rendition (vt rendition)
  (multiple-value-bind (id found) (gethash rendition (terminal-renditions vt))
    (unless found
      (setf id (terminal-style-count vt))
      (when (= id (length (terminal-styles vt)))
        (setf (terminal-styles vt) (replace (make-array (* 2 id) :initial-element nil) (terminal-styles vt))))
      (setf (svref (terminal-styles vt) id) rendition (gethash rendition (terminal-renditions vt)) id)
      (incf (terminal-style-count vt)))
    (setf (terminal-pen vt) (ash id +style-shift+))
    (svref (terminal-styles vt) id)))
(defparameter *ascii-text*
  (let ((texts (make-array 128))) (dotimes (code 128 texts) (setf (svref texts code) (string (code-char code))))))
(defun glyph-length (vt glyph)
  (if (< glyph +cluster-base+) 1 (aref (terminal-cluster-lengths vt) (- glyph +cluster-base+))))
(defun glyph-text (vt glyph)
  (cond ((zerop glyph) " ") ((< glyph 128) (svref *ascii-text* glyph))
        ((< glyph +cluster-base+) (string (code-char glyph)))
        (t (let* ((length (glyph-length vt glyph)) (text (make-string length)) (index (1- length)))
             (loop while (>= glyph +cluster-base+) for node = (aref (terminal-clusters vt) (- glyph +cluster-base+))
                   do (setf (char text index) (code-char (ash node -24))
                            glyph (logand node +glyph-mask+)) (decf index))
             (setf (char text 0) (if (zerop glyph) #\Space (code-char glyph)))
             text))))
(defun intern-cluster (vt parent code)
  (let ((key (logior parent (ash code 24))))
    (multiple-value-bind (id found) (gethash key (terminal-cluster-table vt))
      (unless found
        (setf id (terminal-cluster-count vt))
        (when (>= (+ id +cluster-base+) +glyph-mask+) (error "Terminal cluster pool full"))
        (when (= id (length (terminal-clusters vt)))
          (setf (terminal-clusters vt)
                (replace (make-array (* 2 (max 1 id)) :element-type '(unsigned-byte 64) :initial-element 0)
                         (terminal-clusters vt))
                (terminal-cluster-lengths vt)
                (replace (make-array (* 2 (max 1 id)) :element-type '(unsigned-byte 32) :initial-element 0)
                         (terminal-cluster-lengths vt))))
        (setf (aref (terminal-clusters vt) id) key
              (aref (terminal-cluster-lengths vt) id) (1+ (glyph-length vt parent))
              (gethash key (terminal-cluster-table vt)) id)
        (incf (terminal-cluster-count vt)))
      (+ +cluster-base+ id))))
(defun materialize-row (vt row)
  (let ((out (make-array (row-cols row))))
    (dotimes (x (length out) out)
      (let ((cell (aref row x)))
        (setf (svref out x) (list (if (cell-tail-p cell) "" (glyph-text vt (cell-glyph cell)))
                                (svref (terminal-styles vt) (cell-style cell))))))))
(defun packed-row-runs (vt row)
  (declare (type terminal vt) (type cell-row row))
  (let ((runs nil) (start 0) (style -1) (chars (make-string-output-stream)))
    (dotimes (x (row-cols row))
      (let* ((cell (aref row x)) (id (cell-style cell)))
        (unless (= style id)
          (when (>= style 0) (push (list start (get-output-stream-string chars) (svref (terminal-styles vt) style)) runs))
          (setf start x style id))
        (unless (cell-tail-p cell) (write-string (glyph-text vt (cell-glyph cell)) chars))))
    (when (>= style 0) (push (list start (get-output-stream-string chars) (svref (terminal-styles vt) style)) runs))
    (nreverse runs)))
(defun break-pair (row x blank)
  (declare (type cell-row row) (type fixnum x) (type cell blank))
  (let ((cell (aref row x)))
    (cond ((and (cell-tail-p cell) (plusp x)) (setf (aref row (1- x)) blank))
          ((and (cell-wide-p cell) (< (1+ x) (row-cols row))) (setf (aref row (1+ x)) blank)))))
(defun clear-row (vt row start end blank)
  (declare (type cell-row row) (type fixnum start end) (type cell blank))
  (when (< start end)
    (let ((extent (+ end (if (and (< end (row-cols row)) (cell-wide-p (aref row (1- end)))) 1 0)))
          (wrap-end (- (row-cols row) (if (= (row-wrap row) 2) 1 0))))
      (when (>= extent wrap-end) (setf (row-wrap row) 0)))
    (break-pair row start blank) (break-pair row (1- end) blank)
    (fill row blank :start start :end end)
    (touch-row vt row)))
(defun clear-range (vt start end &optional (rendition (erase-rendition vt)))
  (let* ((saved (terminal-rendition vt))
         (blank (progn (canonical-rendition vt rendition) (terminal-pen vt)))
         (cols (terminal-cols vt)) (cells (terminal-cells vt)))
    (canonical-rendition vt saved)
    (loop for y from (floor start cols) while (< (* y cols) end) do
      (clear-row vt (svref cells y) (max 0 (- start (* y cols))) (min cols (- end (* y cols))) blank))))
(defun wrap-mark (row mark)
  (when (eq mark :pad)
    (let* ((x (1- (row-cols row)))
           (blank (logandc2 (aref row x) (logior +glyph-mask+ +wide+ +tail+))))
      (break-pair row x blank)
      (setf (aref row x) blank)))
  (setf (row-wrap row) (if (eq mark :pad) 2 1)))
(defun blank-cell-p (cell)
  (declare (type cell cell))
  (or (zerop cell) (= cell 32)))
(defun row-blank-p (row)
  (declare (type cell-row row))
  (loop for x below (row-cols row) always (blank-cell-p (aref row x))))
(defun wrap-line (line end cols offsets)
  (let ((rows nil) (count 0) (col 0) (found (make-list (length offsets))) (row (make-row cols)))
    (flet ((close-row (mark)
             (wrap-mark row mark) (push row rows) (incf count) (setf row (make-row cols) col 0)))
      (let ((i 0))
        (loop while (< i end) do
          (let ((width (if (cell-wide-p (aref line i)) 2 1)))
            (unless (> width cols)
              (when (> (+ col width) cols) (close-row (if (= col cols) :wrap :pad)))
              (loop for offset in offsets for slot on found
                    when (and (null (car slot)) (<= i offset (+ i width -1)))
                      do (setf (car slot) (cons count (+ col (- offset i)))))
              (replace row line :start1 col :start2 i :end2 (min end (+ i width)))
              (incf col width))
            (incf i width))))
      (push row rows) (incf count)
      (loop for slot on found unless (car slot) do (setf (car slot) (cons (1- count) (min col (1- cols)))))
      (values (nreverse rows) found))))
(defun reflow-rows (rows cursor-row cursor-x top-row cols)
  (let ((line (make-array 0 :element-type '(unsigned-byte 64) :adjustable t :fill-pointer 0))
        (out nil) (count 0) (cursor nil) (top nil) (cursor-offset nil) (top-offset nil) (more nil))
    (flet ((flush ()
             (let ((end (fill-pointer line)) (keep (if cursor-offset (1+ cursor-offset) 0)))
               (loop while (and (> end keep) (blank-cell-p (aref line (1- end)))) do (decf end))
               (multiple-value-bind (wrapped found)
                   (wrap-line line end cols (remove nil (list cursor-offset top-offset)))
                 (flet ((absolute (position) (cons (+ count (car position)) (cdr position))))
                   (when cursor-offset (setf cursor (absolute (pop found))))
                   (when top-offset (setf top (absolute (pop found)))))
                 (incf count (length wrapped)) (dolist (row wrapped) (push row out))))
             (setf (fill-pointer line) 0 cursor-offset nil top-offset nil more nil)))
      (dotimes (i (length rows))
        (let* ((row (svref rows i)) (width (row-cols row)) (mark (row-wrap row)))
          (when (= i cursor-row) (setf cursor-offset (+ (fill-pointer line) (min cursor-x (1- width)))))
          (when (= i top-row) (setf top-offset (fill-pointer line)))
          (dotimes (x (if (= mark 2) (1- width) width)) (vector-push-extend (aref row x) line))
          (if (plusp mark) (setf more t) (flush))))
      (when more (flush)))
    (values (coerce (nreverse out) 'simple-vector) cursor top)))
(defun reflow-main (vt cells x y cols rows)
  (let* ((old-cols (row-cols (svref cells 0)))
         (content (position-if-not #'row-blank-p cells :from-end t))
         (above (coerce (history-above vt) 'simple-vector))
         (joined (concatenate 'simple-vector above (subseq cells 0 (1+ (max y (or content 0)))))))
    (multiple-value-bind (laid cursor top)
        (reflow-rows joined (+ (length above) y) x (length above) cols)
      (let* ((cursor-row (car cursor))
             (origin (if (or (= y (1- (length cells))) (>= (- cursor-row (car top)) rows))
                         (max 0 (- cursor-row (1- rows))) (car top)))
             (screen (make-array rows)))
        (dotimes (k rows)
          (setf (svref screen k) (if (< (+ origin k) (length laid)) (svref laid (+ origin k)) (make-row cols)))
          (touch-row vt (svref screen k)))
        (setf (terminal-history vt) nil)
        (dotimes (k origin) (remember-row vt (svref laid k)))
        (values screen (+ (cdr cursor) (if (>= x old-cols) 1 0)) (- cursor-row origin)
                (max 1 (min rows (- (length laid) origin))))))))
(defun truncate-cells (vt old cols rows)
  (let ((cells (blank-cells cols rows)))
    (dotimes (y (min rows (length old)))
      (let* ((row (svref cells y)) (from (svref old y)) (width (min cols (row-cols from))))
        (replace row from :end1 width :end2 width)
        (when (and (plusp width) (cell-wide-p (aref row (1- width)))) (setf (aref row (1- width)) 0))
        (touch-row vt row)))
    cells))
(defun resize-terminal (vt cols rows cw ch)
  (unless (and (typep cols '(integer 1 65535)) (typep rows '(integer 1 65535)))
    (error "Invalid terminal dimensions: ~S x ~S" cols rows))
  (incf (terminal-revision vt))
  (unless (and (= cols (terminal-cols vt)) (= rows (terminal-rows vt)))
    (let* ((alternate (eq (terminal-screen vt) :alternate))
           (main (if alternate (terminal-main-cells vt) (terminal-cells vt)))
           (x (if alternate (first (terminal-saved vt)) (terminal-x vt)))
           (y (if alternate (second (terminal-saved vt)) (terminal-y vt))))
      (multiple-value-bind (cells x y used)
          (if main (reflow-main vt main x y cols rows) (values (blank-cells cols rows) 0 0 1))
        (if alternate
            (setf (terminal-cells vt) (truncate-cells vt (terminal-cells vt) cols rows)
                  (terminal-main-cells vt) cells (terminal-saved vt) (list x y)
                  (terminal-main-materialized-rows vt) used
                  (terminal-materialized-rows vt) (min rows (terminal-materialized-rows vt))
                  (terminal-x vt) (min (terminal-x vt) (1- cols))
                  (terminal-y vt) (min (terminal-y vt) (1- rows)))
            (setf (terminal-cells vt) cells (terminal-materialized-rows vt) used
                  (terminal-x vt) x (terminal-y vt) y)))))
  (setf (terminal-cols vt) cols (terminal-rows vt) rows (terminal-cw vt) cw (terminal-ch vt) ch
        (terminal-top vt) 0 (terminal-bottom vt) (1- rows)))
(defun parameters (text &optional (separator #\;))
  (loop for start = 0 then (1+ end) for end = (position separator text :start start)
        for item = (subseq text start end)
        collect (if (zerop (length item)) 0 (or (parse-integer item :junk-allowed t) 0))
        while end))
(defun erase-rendition (vt)
  ;; Erased cells, as in xterm and Zellij, have default attributes and inherit
  ;; only the pending background color, if one is set.
  (let ((codes (rest (terminal-rendition vt)))
        (background nil))
    (labels ((consume-color (mode)
               (case mode
                 (5 (when codes (list mode (pop codes))))
                 (2 (when (>= (length codes) 3)
                      (list mode (pop codes) (pop codes) (pop codes)))))))
      ;; RENDITION is the canonical sequence emitted by UPDATE-RENDITION:
      ;; standard foreground/background values are one-element groups, while
      ;; 38/48/58 consume a mode and its color values. Consume those groups as
      ;; we scan so a foreground RGB component such as 44 or 48 cannot be read
      ;; as a standard background or an extended-background introducer.
      (loop while codes
            for code = (pop codes) do
              (cond
                ((= code 48)
                 (when codes
                   (let ((color (consume-color (pop codes))))
                     (when color (setf background (cons 48 color))))))
                ((member code '(38 58))
                 (when codes (consume-color (pop codes))))
                ((or (<= 40 code 47) (<= 100 code 107))
                 (setf background (list code)))))
      (if background (cons 0 background) '(0)))))
(defun erase-display (vt)
  (when (and (terminal-erase-display-history vt) (eq (terminal-screen vt) :main))
    (dotimes (y (terminal-materialized-rows vt))
      (let ((spare (remember-row vt (svref (terminal-cells vt) y))))
        (setf (svref (terminal-cells vt) y)
              (if (and spare (= (row-cols spare) (terminal-cols vt))) spare (make-row (terminal-cols vt)))))))
  (clear-range vt 0 (* (terminal-cols vt) (terminal-rows vt)))
  (setf (terminal-materialized-rows vt) (terminal-rows vt))
  (when (terminal-erase-display-history vt)
    (setf (terminal-top vt) 0 (terminal-bottom vt) (1- (terminal-rows vt)))))
(defun scroll-lines (vt amount emit)
  (let* ((cells (terminal-cells vt)) (cols (terminal-cols vt))
         (top (terminal-top vt)) (bottom (terminal-bottom vt))
         (n (min (abs amount) (1+ (- bottom top))))
         (history (and (plusp amount) (eq (terminal-screen vt) :main) (zerop top) (= bottom (1- (terminal-rows vt)))))
         (saved (terminal-rendition vt))
         (blank (progn (canonical-rendition vt (erase-rendition vt)) (terminal-pen vt))))
    (canonical-rendition vt saved)
    (dotimes (i n)
      (let ((row (svref cells (if (plusp amount) top bottom))))
        (if (plusp amount)
            (replace cells cells :start1 top :start2 (1+ top) :end2 (1+ bottom))
            (replace cells cells :start1 (1+ top) :end1 (1+ bottom) :start2 top :end2 bottom))
        (when history
          (setf row (remember-row vt row))
          (unless (and row (= (row-cols row) cols)) (setf row (make-row cols))))
        (clear-row vt row 0 cols blank)
        (setf (svref cells (if (plusp amount) bottom top)) row)))
    (when history (ensure-materialized-rows vt (+ (terminal-materialized-rows vt) n)))
    (funcall emit :scroll (logior top (ash bottom 16) (ash (logand (if (minusp amount) (- n) n) #x1ffff) 32)))))
(defun scroll-region (event)
  (declare (type fixnum event))
  (let ((amount (ldb (byte 17 32) event)))
    (values (ldb (byte 16 0) event) (ldb (byte 16 16) event)
            (if (logbitp 16 amount) (- amount #x20000) amount))))
(defun newline (vt emit)
  (if (= (terminal-y vt) (terminal-bottom vt)) (scroll-lines vt 1 emit)
      (progn (setf (terminal-y vt) (min (1- (terminal-rows vt)) (1+ (terminal-y vt))))
             (ensure-materialized-rows vt (1+ (terminal-y vt))))))
(defun character-width (char) (ekko/text:display-width char))
(declaim (inline autowrap-p))
(defun autowrap-p (vt) (terminal-wrap vt))
(defun insert-cells (vt count)
  (let* ((row (svref (terminal-cells vt) (terminal-y vt)))
         (x (min (terminal-x vt) (1- (terminal-cols vt))))
         (cols (terminal-cols vt)) (n (min count (- cols x)))
         (saved (terminal-rendition vt))
         (blank (progn (canonical-rendition vt (erase-rendition vt)) (terminal-pen vt))))
    (canonical-rendition vt saved)
    (when (cell-tail-p (aref row x)) (break-pair row x blank) (setf (aref row x) blank))
    (replace row row :start1 (+ x n) :start2 x :end2 (- cols n))
    (fill row blank :start x :end (+ x n))
    (when (cell-wide-p (aref row (1- cols))) (setf (aref row (1- cols)) blank))
