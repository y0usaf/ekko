(in-package #:ekko/vt)

(defconstant +history-rows+ 10000)
(defconstant +history-bytes+ (* 8 1024 1024))
(defstruct history
  (rows (make-array +history-rows+ :initial-element nil) :type simple-vector)
  (start 0 :type fixnum) (count 0 :type fixnum) (bytes 0 :type fixnum))
(defun row-cost (row) (declare (type cell-row row)) (+ 16 (* 8 (length row))))
(defun history-drop (history)
  (let* ((index (history-start history)) (row (svref (history-rows history) index)))
    (decf (history-bytes history) (row-cost row))
    (setf (svref (history-rows history) index) nil
          (history-start history) (mod (1+ index) +history-rows+))
    (decf (history-count history))
    row))
(defun remember-row (vt row)
  (let ((cost (row-cost row)) (spare nil))
    (when (> cost +history-bytes+) (return-from remember-row row))
    (let ((history (or (terminal-history vt) (setf (terminal-history vt) (make-history)))))
      (loop while (or (= (history-count history) +history-rows+)
                      (> (+ (history-bytes history) cost) +history-bytes+))
            do (setf spare (history-drop history)))
      (setf (svref (history-rows history) (mod (+ (history-start history) (history-count history)) +history-rows+)) row)
      (incf (history-count history)) (incf (history-bytes history) cost))
    spare))
(defun clear-history (vt)
  (when (and (terminal-history vt) (eq (terminal-screen vt) :main))
    (let ((history (terminal-history vt)))
      (fill (history-rows history) nil)
      (setf (history-start history) 0 (history-count history) 0 (history-bytes history) 0))))
(defun history-above (vt)
  (let ((history (terminal-history vt)))
    (when history
      (loop for i below (history-count history)
            collect (svref (history-rows history) (mod (+ (history-start history) i) +history-rows+))))))
(defun history-cells (vt)
  (map 'vector (lambda (row) (materialize-row vt row))
       (append (when (eq (terminal-screen vt) :main) (history-above vt))
               (coerce (terminal-cells vt) 'list))))
(defun history-text (vt) (map 'vector #'row-text (history-cells vt)))
(defun row-text (row)
  (string-right-trim " " (with-output-to-string (out)
                           (loop for cell across row do (write-string (first cell) out)))))
